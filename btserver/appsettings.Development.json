{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "btserver.torrent.impl": "Debug"
      }
    }
  },
  "Mqtt": {
    "ClientId": "boottorrent-server",
    "Server": "localhost",
    "Port": 1883,
    "UseTls": false,
    "CleanSession": true
  },
  "Torrent" : {
    "TrackerUrl" : "http://127.0.0.1:6969/",
    "ArtifactStoragePath" : "./tmp/artifacts",
    "ArtifactUploadRoot" : "./tmp/uploads",
    "TrackerId" : "btserver",
    "TrackerPort" : 6969,
    "TrackerBindAddress" : "http://+:6969/"
  },
  "MachineRegistry": {
    "HeartbeatTimeoutSeconds": 90,
    "HeartbeatCheckIntervalSeconds": 15
  }
}
