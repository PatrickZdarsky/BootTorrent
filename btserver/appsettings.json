{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=btserver.db"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "MachineRegistry": {
    "HeartbeatTimeoutSeconds": 90,
    "HeartbeatCheckIntervalSeconds": 15
  }
}
